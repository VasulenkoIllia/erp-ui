// Підставляється після `shadcn add`: моки за контрактом (лише перевірка типів, у збірку не входить).
import { setupWorker } from "msw/browser"
import { z } from "zod"

import { recordBaseSchema } from "@/lib/api"
import { setScenario } from "@/lib/mock-scenarios"
import {
  createPlatformHandlers,
  createResourceHandlers,
  type MockAccountSeed,
  type MockUser,
} from "@/lib/mocks"

const invoice = recordBaseSchema.extend({
  client: z.string().min(1),
  amount: z.number().int(),
  companyId: z.string().nullable(),
})

const users: MockUser[] = [
  {
    id: "u1",
    name: "Олена Коваль",
    email: "olena@example.com",
    password: "demo",
    totpCode: "123456",
    roles: ["accountant"],
    permissions: ["invoices:*"],
    companies: [{ id: "a", name: "ТОВ «А»" }],
    companyId: "a",
    phone: "+380671234545",
    factors: ["totp", "sms"],
  },
]

const accountSeeds: Record<string, MockAccountSeed> = {
  u1: {
    sessions: [
      {
        id: "s1",
        device: { type: "mobile", browser: "Safari", os: "iOS" },
        location: { uk: "Львів, Україна", en: "Lviv, Ukraine" },
        createdAt: "2026-10-01T08:00:00.000Z",
        lastActiveAt: "2026-10-13T08:00:00.000Z",
      },
    ],
  },
}

const invoices = createResourceHandlers({
  resource: "invoices",
  schema: invoice,
  data: [{ id: "1", version: 1, client: "ТОВ «А»", amount: 10000, companyId: "a" }],
  searchFields: ["client"],
  label: { uk: "Рахунки", en: "Invoices" },
  fieldLabels: { client: { uk: "Клієнт", en: "Client" } },
})

export async function startMocks() {
  setScenario("success")
  await setupWorker(
    ...createPlatformHandlers({
      users,
      accountSeeds,
      branding: { name: "ТОВ «А»", palette: "teal" },
      twoFactorRequired: () => true,
      securityPolicy: { twoFactor: "roles", twoFactorRoles: ["accountant"], ipAllowlist: [] },
      roles: [{ id: "accountant", name: { uk: "Бухгалтер", en: "Accountant" } }],
      apiResources: { invoices: { uk: "Рахунки", en: "Invoices" } },
      webhookEvents: { "invoices.created": { label: { uk: "Рахунок створено", en: "Invoice created" } } },
      notificationEvents: [
        {
          id: "invoices.overdue",
          group: { uk: "Рахунки", en: "Invoices" },
          label: { uk: "Прострочено", en: "Overdue" },
          channels: ["in_app", "email"],
          defaults: ["in_app"],
        },
      ],
      auditSeeds: [],
    }),
    ...invoices.handlers,
  ).start()
}
