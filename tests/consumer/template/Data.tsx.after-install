import { QueryClient } from "@tanstack/react-query"
import i18next from "i18next"
import { CoreAdminContext, useGetList, useUpdate } from "ra-core"
import { useState } from "react"

import {
  SessionsSection,
  SignInAlertsSwitch,
  SignInHistory,
  TrustedDevicesSection,
} from "@/components/erp/account-devices"
import { FactorsSection } from "@/components/erp/account-factors"
import { ApiTokensSection } from "@/components/erp/api-tokens"
import { AvatarEditor } from "@/components/erp/avatar-editor"
import { BackupCodesDialog, FactorSetupStep } from "@/components/erp/factor-setup"
import { ProfileForm, ProfilePhoto } from "@/components/erp/profile-form"
import { RecoveryRequestsSection, useResetFactors } from "@/components/erp/reset-factors"
import { SecurityPolicyForm } from "@/components/erp/security-policy-form"
import { TimezoneSelect } from "@/components/erp/timezone-select"
import { AccountDataSection, ChangeEmailForm, ChangePasswordForm } from "@/components/erp/account-security"
import { AcceptInviteScreen, ForgotPasswordScreen } from "@/components/erp/account-recovery"
import { BrandLogo, useBrandAppearance, useBranding } from "@/components/erp/auth-layout"
import { CopyButton } from "@/components/erp/copy-button"
import { ImpersonationBanner, useImpersonation } from "@/components/erp/impersonation"
import { QrCode } from "@/components/erp/qr-code"
import { ConflictDialog } from "@/components/erp/conflict-dialog"
import { DevPanel } from "@/components/erp/dev-panel"
import { LoginScreen } from "@/components/erp/login-screen"
import { SessionGuard } from "@/components/erp/session-guard"
import { SignUpScreen } from "@/components/erp/sign-up-screen"
import { useApiErrorMessage } from "@/hooks/use-api-error-message"
import { useHasPermission, useMe } from "@/hooks/use-me"
import { createApiClient, isApiError } from "@/lib/api"
import { getAppearance } from "@/lib/appearance"
import { createAuthProvider, ME_QUERY_KEY } from "@/lib/auth"
import { ipAllowed, isValidCidr } from "@/lib/security-policy"
import { createDataProvider } from "@/lib/data-provider"
import { syncPreferences } from "@/lib/preferences"
import { createRaI18nProvider } from "@/lib/ra-i18n"

const queryClient = new QueryClient()
const api = createApiClient({
  getCompanyId: () => "a",
  getLanguage: () => getAppearance().language,
})
const authProvider = createAuthProvider(api, {
  onMe: (me) => {
    queryClient.setQueryData(ME_QUERY_KEY, me)
  },
})
const dataProvider = createDataProvider(api)

interface Invoice {
  id: string
  version: number
  client: string
}

function Invoices() {
  const { data: me } = useMe()
  const canEdit = useHasPermission("invoices", "update")
  const { data, error } = useGetList<Invoice>("invoices", {
    pagination: { page: 1, perPage: 25 },
    sort: { field: "date", order: "DESC" },
    filter: { status: ["paid", "sent"], amount_gte: 10000 },
  })
  const [update] = useUpdate<Invoice>()
  const message = useApiErrorMessage()
  const [conflict, setConflict] = useState<Invoice | null>(null)
  const first = data?.[0]
  return (
    <>
      <p>
        {me?.name} {error ? message(error) : data?.length}
      </p>
      <button
        type="button"
        disabled={!canEdit || !first}
        onClick={() => {
          if (!first) return
          void update(
            "invoices",
            { id: first.id, data: { client: "ТОВ «Б»", version: first.version }, previousData: first },
            {
              mutationMode: "pessimistic",
              onError: (e) => {
                if (isApiError(e) && e.code === "conflict") setConflict(e.current as Invoice)
              },
            },
          )
        }}
      >
        Зберегти
      </button>
      <ConflictDialog
        open={conflict !== null}
        onOpenChange={() => setConflict(null)}
        fields={conflict ? [{ key: "client", label: "Клієнт", mine: "ТОВ «Б»", theirs: conflict.client }] : []}
        onOverwrite={() => setConflict(null)}
        onReload={() => setConflict(null)}
      />
      <DevPanel resources={["invoices"]} compact onChange={() => void queryClient.invalidateQueries()} />
    </>
  )
}

function Admin() {
  const [zone, setZone] = useState("Europe/Kyiv")
  const reset = useResetFactors({ onDone: () => undefined })
  return (
    <>
      <ProfilePhoto />
      <ProfileForm />
      <AvatarEditor name="Олена" onSave={async () => undefined} onRemove={async () => undefined} maxBytes={1024} />
      <TimezoneSelect value={zone} onValueChange={setZone} />
      <ApiTokensSection />
      <SecurityPolicyForm />
      <RecoveryRequestsSection />
      <FactorSetupStep factors={["totp", "email"]} onComplete={() => authProvider.completeFactorSetup()} />
      <button type="button" onClick={() => reset.start({ id: "u2", name: "Іван", email: "ivan@example.com" })}>
        {isValidCidr("10.0.0.0/8") && ipAllowed("10.1.2.3", ["10.0.0.0/8"]) ? "Скинути" : "—"}
      </button>
      {reset.dialog}
    </>
  )
}

function Account() {
  useBrandAppearance()
  const branding = useBranding()
  const { start, dialog } = useImpersonation({ onStarted: () => undefined })
  return (
    <>
      <ImpersonationBanner onStopped={() => undefined} />
      {branding ? <BrandLogo branding={branding} /> : null}
      <FactorsSection />
      <BackupCodesDialog codes={null} onClose={() => undefined} />
      <SessionsSection />
      <TrustedDevicesSection />
      <SignInAlertsSwitch />
      <SignInHistory perPage={20} />
      <QrCode value="otpauth://totp/a:b?secret=ABC" label="QR" />
      <CopyButton value="ABC" label="Копіювати" />
      <button type="button" onClick={() => start({ id: "u2", name: "Іван" })}>
        Увійти як…
      </button>
      {dialog}
    </>
  )
}

export function Data() {
  return (
    <CoreAdminContext
      dataProvider={dataProvider}
      authProvider={authProvider}
      i18nProvider={createRaI18nProvider(i18next)}
      queryClient={queryClient}
    >
      <Invoices />
      <LoginScreen afterLogin="/invoices" />
      <ForgotPasswordScreen />
      <AcceptInviteScreen token="t" />
      <SignUpScreen />
      <SessionGuard idleMinutes={30} />
      <ChangePasswordForm />
      <ChangeEmailForm />
      <AccountDataSection />
      <Account />
      <Admin />
    </CoreAdminContext>
  )
}

export const startPreferences = () => syncPreferences(api)
