function Team() {
  const roles = useRoles()
  const unread = useUnreadNotifications()
  const company = useCompanyProfile()
  const [companyId, switchCompany] = useCompany()
  const [picked, setPicked] = useState<string[]>([])
  const resetUserData = useResetUserData()
  const refreshMe = useRefreshMe()
  useBrandAppearance(company.data?.palette)
  return (
    <>
      <button type="button" data-scope={JSON.stringify(companyScope(companyId))} onClick={() => switchCompany("b")}>
        b
      </button>
      <button type="button" onClick={() => void refreshMe().then(resetUserData)}>
        refresh
      </button>
      <InboxBell onNavigate={() => undefined} onShowAll={() => undefined} />
      <NotificationInbox onNavigate={() => undefined} perPage={10} />
      <RolesEditor />
      <InvitationsSection />
      <PermissionGate resource="invoices" action="delete" fallback={<span>—</span>}>
        <span>{grants(["invoices:*"], "invoices", "delete") ? unread.data : countGranted([], [])}</span>
      </PermissionGate>
      {roles.data ? (
        <RolePicker roles={roles.data.roles} value={picked} onChange={setPicked} legend="Ролі" />
      ) : null}
      <CompanyProfileForm />
      <CompanyImages />
      <CompanyBranchesSection />
    </>
  )
}

