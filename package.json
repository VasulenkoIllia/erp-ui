{
  "name": "erp-ui",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @erp-ui/demo dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check . && node scripts/check-tokens.mjs && pnpm check:contrast && pnpm check:registry",
    "format": "prettier --write .",
    "test": "node --test \"scripts/*.test.mjs\" \"design/*.test.mjs\" && pnpm -r test",
    "e2e": "pnpm --filter @erp-ui/demo e2e",
    "e2e:repeat": "pnpm --filter @erp-ui/demo e2e:repeat",
    "perf": "pnpm --filter @erp-ui/demo perf",
    "screenshots": "pnpm --filter @erp-ui/demo screenshots",
    "themes": "node design/generate-themes.mjs && node design/check-contrast.mjs",
    "check:contrast": "node design/generate-themes.mjs --check && node design/check-contrast.mjs --check",
    "registry": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/build-registry.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs",
    "consumer-smoke": "node scripts/consumer-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
